# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production only: the HTTPS origins that may post forms, e.g. https://data-mechanics.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production only: seconds browsers must keep using HTTPS. Raise to 31536000 once HTTPS is stable.
DJANGO_HSTS_SECONDS=3600
# Public repository of the site's code; the link stays hidden while empty.
GITHUB_URL=
# PostgreSQL. docker-compose.yml reads the same values to create the database.
POSTGRES_DB=datamechanics
POSTGRES_USER=datamechanics
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
