msgid "digital divide"
msgstr "digitale kluft"

#: metrics/catalog.py:1216 metrics/catalog.py:2127
msgid "connectivity"
msgstr "anbindung"

#: metrics/catalog.py:1216 metrics/catalog.py:2127
