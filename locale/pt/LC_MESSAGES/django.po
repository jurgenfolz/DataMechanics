msgid "Happiness"
msgstr "Felicidade"

#: metrics/catalog.py:659
msgid "Well-being"
msgstr "Bem-estar"

#: metrics/catalog.py:659
msgid "World Happiness Report"
msgstr "World Happiness Report"

#: metrics/catalog.py:660
msgid "happiness"
msgstr "felicidade"

#: metrics/catalog.py:660
