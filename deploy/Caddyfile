# Caddy for data-mechanics.com. It gets and renews the HTTPS certificates by itself.
# Installed to /etc/caddy/Caddyfile by deploy/setup-server.sh.

www.data-mechanics.com {
	redir https://data-mechanics.com{uri} permanent
}

data-mechanics.com {
	encode zstd gzip
	# Don't tell visitors which server software runs behind Caddy.
	header -Server

	# collectstatic gives files content-hashed names, so they can be cached for a year.
	handle_path /static/* {
		root * /srv/datamechanics/staticfiles
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Flags and blog images.
	handle_path /media/* {
		root * /srv/datamechanics/media
		header Cache-Control "public, max-age=86400"
		file_server
	}

	handle {
		reverse_proxy unix//run/datamechanics/gunicorn.sock
	}

	log {
		output file /var/log/caddy/data-mechanics.log
	}
}
