# Caddy for data-mechanics.com. It gets and renews the HTTPS certificates by itself.
# Installed to /etc/caddy/Caddyfile by deploy/setup-server.sh.

www.data-mechanics.com {
	redir https://data-mechanics.com{uri} permanent
}

data-mechanics.com {
	encode zstd gzip
	# Don't tell visitors which server software runs behind Caddy.
	header -Server

	# collectstatic gives files content-hashed names, so they can be cached for a year.
	handle_path /static/* {
		root * /srv/datamechanics/staticfiles
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Flags and blog images.
	handle_path /media/* {
		root * /srv/datamechanics/media
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# The visitor dashboard, built by deploy/stats.sh. Its login lives only on the server, in /etc/caddy/stats-auth.
	redir /stats /stats/
	handle_path /stats/* {
		import /etc/caddy/stats-auth
		header X-Robots-Tag "noindex, nofollow"
		header Cache-Control "no-store"
		root * /srv/stats
		file_server
	}

	handle {
		reverse_proxy unix//run/datamechanics/gunicorn.sock
	}

	# The access log feeds the visitor dashboard. Caddy rolls it at 100 MiB and keeps 90 days, so the dashboard covers them.
	log {
		output file /var/log/caddy/data-mechanics.log {
			roll_size 100MiB
			roll_keep 30
			roll_keep_for 2160h
		}
	}
}
