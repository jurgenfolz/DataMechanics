# The Django site, served by Gunicorn on a Unix socket that Caddy proxies to.
[Unit]
Description=Data Mechanics (Gunicorn)
After=network.target docker.service
Wants=docker.service

[Service]
User=datamechanics
Group=datamechanics
WorkingDirectory=/srv/datamechanics
RuntimeDirectory=datamechanics
# The socket is open to the datamechanics group only; Caddy is a member (deploy/setup-server.sh).
UMask=0007
ExecStart=/srv/datamechanics/.venv/bin/gunicorn config.wsgi:application --bind unix:/run/datamechanics/gunicorn.sock --umask 007 --workers 3 --access-logfile - --error-logfile -
Restart=on-failure

[Install]
WantedBy=multi-user.target
